{
  "name": "ai-demo-marketplace-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').existsSync('scripts/build-index.mjs') && require('child_process').execFileSync(process.execPath, ['scripts/build-index.mjs'], {stdio:'inherit'})\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "culori": "^4.0.2",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
